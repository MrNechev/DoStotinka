{
  "name": "dostotinka",
  "version": "0.5.1",
  "private": true,
  "description": "Self-hosted personal budget & money manager",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dostotinka/server --filter @dostotinka/web dev",
    "dev:server": "pnpm --filter @dostotinka/server dev",
    "dev:web": "pnpm --filter @dostotinka/web dev",
    "build": "pnpm --filter @dostotinka/web build && pnpm --filter @dostotinka/server build",
    "start": "pnpm --filter @dostotinka/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @dostotinka/server db:generate",
    "db:migrate": "pnpm --filter @dostotinka/server db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
