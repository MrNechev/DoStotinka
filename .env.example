# ─── DoStotinka configuration ───────────────────────────────────────────
# Copy this file to `.env` next to docker-compose.yml and adjust the values.
# All options are documented in README.md.

# Port on the host where the web app will be reachable.
DOSTOTINKA_PORT=8742

# Image tag to run (e.g. `latest` or a release such as `0.1.0`).
DOSTOTINKA_VERSION=latest

# PostgreSQL credentials. Use a long random password (letters and digits only).
DB_USERNAME=dostotinka
DB_PASSWORD=change-me-to-a-long-random-password
DB_DATABASE_NAME=dostotinka

# Where the database files are stored on the host.
DB_DATA_LOCATION=./postgres

# Allow new users to sign up. Set to false after creating your own account(s).
ALLOW_REGISTRATION=true

# Create a demo account (demo@dostotinka.app / demo1234) filled with example data.
# Its data is regenerated every 24 hours. Disable it on private instances.
DEMO_ENABLED=true

# `auto` marks the session cookie as Secure when the request arrived over HTTPS.
COOKIE_SECURE=auto

# Set to `true` when running behind a reverse proxy (Caddy, Nginx, Traefik …).
TRUST_PROXY=false

# Public address of the app, e.g. https://money.example.com (needed for single sign-on).
# PUBLIC_URL=

# Single sign-on with OpenID Connect (Authentik, Authelia, Keycloak, Google …).
# Redirect URI to register at the provider: <PUBLIC_URL>/api/auth/oidc/callback
# OIDC_ISSUER_URL=https://auth.example.com/application/o/dostotinka/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_BUTTON_TEXT=Log in with Authentik
# OIDC_AUTO_REGISTER=true

# Download daily exchange rates from the European Central Bank.
EXCHANGE_RATES_AUTO_UPDATE=true

# Automatic import of transactions (phone notifications, open banking via Enable Banking).
AUTOMATIC_IMPORT=true
# Encrypts the bank access keys stored in the database, e.g. `openssl rand -hex 32`.
# Keep it when moving the server – without it the key is generated and kept in the database.
# ENCRYPTION_KEY=

# Time zone of the container (used for logs and background jobs).
TZ=Europe/Sofia

# Optional automatic backups (start with: docker compose --profile backup up -d)
BACKUP_LOCATION=./backups
BACKUP_KEEP_DAYS=14
