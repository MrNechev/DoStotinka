# ─── Slavotax configuration ───────────────────────────────────────────
# Copy this file to `.env` next to docker-compose.yml and adjust the values.
# All options are documented in README.md.

# Port on the host where the web app will be reachable.
SLAVOTAX_PORT=3000

# Image tag to run (e.g. `latest` or a release such as `0.1.0`).
SLAVOTAX_VERSION=latest

# PostgreSQL credentials. Use a long random password (letters and digits only).
DB_USERNAME=slavotax
DB_PASSWORD=change-me-to-a-long-random-password
DB_DATABASE_NAME=slavotax

# Where the database files are stored on the host.
DB_DATA_LOCATION=./postgres

# Allow new users to sign up. Set to false after creating your own account(s).
ALLOW_REGISTRATION=true

# Create a demo account (demo@slavotax.app / demo1234) filled with example data.
# Its data is regenerated every 24 hours. Disable it on private instances.
DEMO_ENABLED=true

# `auto` marks the session cookie as Secure when the request arrived over HTTPS.
COOKIE_SECURE=auto

# Set to `true` when running behind a reverse proxy (Caddy, Nginx, Traefik …).
TRUST_PROXY=false

# Download daily exchange rates from the European Central Bank.
EXCHANGE_RATES_AUTO_UPDATE=true

# Time zone of the container (used for logs and background jobs).
TZ=Europe/Sofia
